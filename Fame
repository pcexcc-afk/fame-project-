<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fame Checker</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { background-color: #17212b; color: #ffffff; font-family: sans-serif; padding: 20px; text-align: center; margin: 0; }
        h1 { color: #2ea6ff; margin-bottom: 20px; }
        .card { background: #232e3c; padding: 15px; border-radius: 10px; margin-bottom: 15px; text-align: left; }
        .btn { display: block; background: #2ea6ff; color: #fff; padding: 12px; margin: 10px 0; border-radius: 8px; text-decoration: none; font-weight: bold; text-align: center; }
        .btn-red { background: #ff4d4d; }
        input { width: 100%; padding: 10px; border-radius: 8px; border: none; margin-bottom: 10px; box-sizing: border-box; }
    </style>
</head>
<body>

    <h1>🕵️‍♂️ Fame Checker</h1>

    <div class="card">
        <h3>🔍 Проверка ника</h3>
        <input type="text" id="nick" placeholder="Введи @username">
        <button class="btn" onclick="check()">Проверить (100 ⭐)</button>
    </div>

    <div class="card">
        <h3>⚠️ Базы</h3>
        <a href="#" class="btn btn-red">Скам-база</a>
        <a href="#" class="btn">Фейк-база</a>
        <a href="#" class="btn">👑 Фейм-база</a>
    </div>

    <script>
        function check() {
            const nick = document.getElementById('nick').value;
            if (!nick) { alert("Введи ник!"); return; }
            alert("Проверка " + nick + " запущена (это демо-режим).");
        }
    </script>
</body>
</html>
